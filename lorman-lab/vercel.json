{
  "version": 2,
  "buildCommand": "npx vite build --config vite.config.prod.ts",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lorman-academia.vercel.app"
        }
      ],
      "dest": "https://academialorman.es/$1",
      "status": 308
    },
    {
      "src": "/aula",
      "status": 307,
      "headers": {
        "Location": "https://aula.academialorman.es/course/view.php?id=2"
      }
    },
    {
      "src": "/celador-murcia",
      "status": 308,
      "headers": {
        "Location": "https://celadorsms.academialorman.es/"
      }
    },
    {
      "src": "/celador-murcia/",
      "status": 308,
      "headers": {
        "Location": "https://celadorsms.academialorman.es/"
      }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
