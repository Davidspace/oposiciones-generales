{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ss-casolab.local/schema/claim.schema.json",
  "title": "SS CasoLab normative claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId", "assetId", "version", "statement", "sourceUrl",
    "sourceLocation", "officialPublication", "validFrom", "validTo",
    "legislationCutoffAt", "owner", "reviewStatus", "sourceCheckedAt",
    "nextReviewAt", "dependentAssetIds", "provenance"
  ],
  "properties": {
    "claimId": { "type": "string", "pattern": "^clm-(g|ss)-[0-9]{2}-[0-9]{3}$" },
    "assetId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "statement": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sourceLocation": { "type": "string", "minLength": 1 },
    "officialPublication": { "type": "string", "minLength": 1 },
    "validFrom": { "$ref": "#/$defs/date" },
    "validTo": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "legislationCutoffAt": { "$ref": "#/$defs/date" },
    "owner": { "type": "string", "minLength": 1 },
    "reviewStatus": { "enum": ["pending", "reviewed", "approved", "retired"] },
    "sourceCheckedAt": { "$ref": "#/$defs/date" },
    "reviewedAt": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "nextReviewAt": { "$ref": "#/$defs/date" },
    "dependentAssetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": { "properties": { "reviewStatus": { "enum": ["reviewed", "approved"] } }, "required": ["reviewStatus"] },
      "then": { "required": ["reviewedAt"] }
    }
  ],
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt", "changeLog"],
      "properties": {
        "createdBy": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/date" },
        "changeLog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "date", "changedBy", "summary"],
            "properties": {
              "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
              "date": { "$ref": "#/$defs/date" },
              "changedBy": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
