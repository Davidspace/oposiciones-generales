{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ss-casolab.local/schema/question.schema.json",
  "title": "SS CasoLab multiple-choice question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "status", "themes", "epigraph", "competency",
    "difficulty", "prompt", "options", "normativeClaimIds", "sources",
    "validFrom", "validTo", "legislationCutoffAt", "visibility",
    "academicReviewStatus", "legalReviewStatus", "nextReviewAt", "provenance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(g|ss)-[0-9]{2}-q[0-9]{3}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["pending", "draft", "reviewed", "external-review", "published", "retired"] },
    "themes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "epigraph": { "type": "string", "minLength": 1 },
    "competency": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["basic", "medium", "high"] },
    "prompt": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "isCorrect", "feedback"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "isCorrect": { "type": "boolean" },
          "feedback": { "type": "string", "minLength": 1 },
          "errorType": { "type": "string", "minLength": 1 },
          "reviewTarget": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "isCorrect": { "const": false } },
              "required": ["isCorrect"]
            },
            "then": { "required": ["errorType", "reviewTarget"] }
          }
        ]
      }
    },
    "normativeClaimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "location", "consultedAt"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "location": { "type": "string", "minLength": 1 },
          "consultedAt": { "$ref": "#/$defs/date" }
        }
      }
    },
    "validFrom": { "$ref": "#/$defs/date" },
    "validTo": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "legislationCutoffAt": { "$ref": "#/$defs/date" },
    "visibility": { "enum": ["practice", "assessment-only"] },
    "academicReviewStatus": { "enum": ["pending", "approved", "rejected"] },
    "academicReviewer": { "type": "string" },
    "reviewedAt": { "$ref": "#/$defs/date" },
    "legalReviewStatus": { "enum": ["not-required", "pending", "approved", "rejected"] },
    "legalReviewer": { "type": "string", "minLength": 1 },
    "legalReviewedAt": { "$ref": "#/$defs/date" },
    "nextReviewAt": { "$ref": "#/$defs/date" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": { "properties": { "academicReviewStatus": { "const": "approved" } }, "required": ["academicReviewStatus"] },
      "then": { "required": ["academicReviewer", "reviewedAt"] }
    },
    {
      "if": { "properties": { "legalReviewStatus": { "const": "approved" } }, "required": ["legalReviewStatus"] },
      "then": { "required": ["legalReviewer", "legalReviewedAt"] }
    },
    {
      "if": { "properties": { "status": { "const": "published" } }, "required": ["status"] },
      "then": {
        "properties": {
          "academicReviewStatus": { "const": "approved" },
          "legalReviewStatus": { "enum": ["approved", "not-required"] }
        },
        "required": ["academicReviewer", "reviewedAt"]
      }
    }
  ],
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt", "changeLog"],
      "properties": {
        "createdBy": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/date" },
        "changeLog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "date", "changedBy", "summary"],
            "properties": {
              "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
              "date": { "$ref": "#/$defs/date" },
              "changedBy": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
