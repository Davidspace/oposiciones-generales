# Public, non-secret destination used by the product navigation.
NEXT_PUBLIC_PORTFOLIO_URL=https://lorman-lab.vercel.app

# Enable only after the privacy notice identifies the data controller.
SS_CASOLAB_ANALYTICS_ENABLED=false
SS_CASOLAB_CAPTURE_ENABLED=false
GSI_CASO_0_CAPTURE_ENABLED=false

# Keep orders closed until the seller data, terms and professional Bizum service
# are complete and the full order-to-Moodle flow has passed its release gate.
SS_CASOLAB_ORDERING_ENABLED=false
SS_CASOLAB_PRODUCT_ID=ss-casolab-beta
SS_CASOLAB_OFFER_VERSION=beta-2026-07
SS_CASOLAB_PRICE_CENTS=4900
SS_CASOLAB_CURRENCY=EUR
SS_CASOLAB_ORDER_TTL_HOURS=48

# Professional/commercial Bizum only. Never configure a personal P2P number.
SS_CASOLAB_BIZUM_MODE=professional_manual
SS_CASOLAB_BIZUM_RECIPIENT=
SS_CASOLAB_BIZUM_DISPLAY_NAME=

# E.164 digits without spaces or a leading plus sign, for wa.me links.
SS_CASOLAB_WHATSAPP_PHONE=
SS_CASOLAB_SUPPORT_HOURS=

# Mandatory commercial disclosures. Do not enable orders while any is empty.
SS_CASOLAB_SELLER_LEGAL_NAME=
SS_CASOLAB_SELLER_NIF=
SS_CASOLAB_SELLER_ADDRESS=
SS_CASOLAB_SELLER_EMAIL=
SS_CASOLAB_TERMS_VERSION=
SS_CASOLAB_PRIVACY_VERSION=
SS_CASOLAB_PRODUCT_INVENTORY_URL=
SS_CASOLAB_TERMS_URL=
SS_CASOLAB_PRIVACY_URL=
SS_CASOLAB_WITHDRAWAL_URL=

# Explicit Gate 2 approval after legal, banking, D1, Moodle and WhatsApp evidence.
# These fields do not replace the evidence; they prevent accidental activation.
SS_CASOLAB_GATE2_APPROVAL_ID=
SS_CASOLAB_GATE2_APPROVED_AT=
SS_CASOLAB_GATE2_APPROVED_BY=

# Use independent high-entropy values. Never commit real secrets.
SS_CASOLAB_ADMIN_ENABLED=false
SS_CASOLAB_ADMIN_DAVID_SECRET=
SS_CASOLAB_ADMIN_ALBA_SECRET=
SS_CASOLAB_LOOKUP_HMAC_SECRET=
SS_CASOLAB_PAYMENT_REFERENCE_HMAC_SECRET=
SS_CASOLAB_PAYMENT_REFERENCE_HMAC_VERSION=v1

SS_CASOLAB_MOODLE_BASE_URL=
