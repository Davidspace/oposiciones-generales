# Public, non-secret destination used by the product navigation.
NEXT_PUBLIC_PORTFOLIO_URL=https://lorman-lab.vercel.app

# Keep telemetry and lead capture disabled until the privacy notice identifies
# the controller and the deployment has a tested data-retention policy.
TAI_ACADEMIA_ANALYTICS_ENABLED=false
TAI_ACADEMIA_CAPTURE_ENABLED=false
TAI_ACADEMIA_PRIVACY_URL=
TAI_ACADEMIA_PRIVACY_VERSION=

# The product has no ordering endpoint in this deployment.
# Never put credentials, database URLs or lead data in this file.
