{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/prueba-gratis",
      "destination": "/?utm_source=whatsapp&utm_medium=community&utm_campaign=celador_sms_murcia_2026&utm_content=prueba_gratis#prueba",
      "permanent": false
    },
    {
      "source": "/telegram",
      "destination": "/?utm_source=telegram&utm_medium=community&utm_campaign=celador_sms_murcia_2026&utm_content=grupos#prueba",
      "permanent": false
    },
    {
      "source": "/whatsapp",
      "destination": "/?utm_source=whatsapp&utm_medium=community&utm_campaign=celador_sms_murcia_2026&utm_content=difusion#prueba",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "celador-sms-murcia.vercel.app" }
      ],
      "destination": "https://celadorsms.academialorman.es/:path*",
      "permanent": true
