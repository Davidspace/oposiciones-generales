{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "auxiliar-juridico.vercel.app"
        }
      ],
      "destination": "https://auxiliojudicial.academialorman.es/:path*",
      "permanent": true
    }
  ]
}
